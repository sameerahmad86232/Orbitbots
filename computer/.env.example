# Generate at least 32 random bytes; do not use an example string as a token.
ORBIT_TOKEN=
# Optional separate shared-workspace roles. Empty disables each role.
ORBIT_REVIEWER_TOKEN=
ORBIT_VIEWER_TOKEN=
# Optional always-on vision worker, OpenAI-compatible /chat/completions endpoint.
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
MODEL_OUTPUT_TOKENS=1024
MODEL_TOKEN_FIELD=max_tokens
# Off by default. Commands run inside this container, not a strong VM sandbox.
ORBIT_ALLOW_TERMINAL=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Public HTTPS origin, also used for registered OAuth callbacks.
PUBLIC_BASE_URL=
ORBIT_DOMAIN=
# Optional semantic retrieval. OpenAI-compatible /embeddings protocol, including Ollama /v1.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
AGENT_SEMANTIC_RAG=0
# Optional OpenAI-compatible image/audio providers. Empty disables each feature.
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
TRANSCRIBE_API_KEY=
SPEECH_BASE_URL=
SPEECH_MODEL=
SPEECH_API_KEY=
SPEECH_VOICE=alloy
# Video uses xAI's /videos/generations + /videos/{id} JSON protocol.
VIDEO_BASE_URL=https://api.x.ai/v1
VIDEO_MODEL=
VIDEO_API_KEY=
REALTIME_API_KEY=
REALTIME_MODEL=
REALTIME_VOICE=marin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_RETURN_URL=
STRIPE_WEBHOOK_SECRET=
